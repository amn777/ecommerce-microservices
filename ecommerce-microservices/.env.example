# ──────────────────────────────────────────
# Microservices E-Commerce Environment Config
# ──────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secret_2024

# Redis
REDIS_PASSWORD=redis_secret_2024

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production_2024
JWT_EXPIRES_IN=7d

# Stripe (replace with real key for payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_key_here

# SMTP (for notification service)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@yourecommerce.com
SMTP_PASS=your_smtp_password

# Service URLs (used internally)
NODE_ENV=development
